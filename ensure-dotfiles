#!/usr/bin/env bash

set -eou pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Check if Ansible is installed
if ! command -v ansible-playbook &> /dev/null; then
  echo "❌ >>> Ansible is not installed"
  echo ""
  echo "Install Ansible:"
  echo "  macOS:      brew install ansible"
  echo "  Arch Linux: sudo pacman -S ansible"
  echo "  Python:     pipx install --include-deps ansible"
  exit 1
fi

# Install Ansible collections
echo "⏳ >>> Installing Ansible collections..."
ansible-galaxy collection install -r requirements.yml

# Detect if we need sudo password (Linux systems)
EXTRA_ARGS="$@"
if [[ "$OSTYPE" == "linux-gnu"* ]] && [[ ! "$EXTRA_ARGS" =~ "-K" ]] && [[ ! "$EXTRA_ARGS" =~ "--ask-become-pass" ]]; then
  echo "🔐 >>> Note: Installing essential tools (starship, zoxide, atuin, eza) requires sudo..."
  EXTRA_ARGS="--ask-become-pass $EXTRA_ARGS"
fi

# Run the dotfiles playbook
echo "⏳ >>> Setting up dotfiles and zsh..."
ansible-playbook -i localhost, -c local dotfiles.yml $EXTRA_ARGS

echo "✨ >>> Dotfiles setup complete!"
