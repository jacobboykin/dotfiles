# Copy this file to vars/secrets.yml and fill in your values

---
# System user configuration
username: "your-system-username"

# Git configuration
git_user_name: "Your Name"
git_user_email: "your.email@example.com"
git_signing_key: "YOUR_GPG_KEY_ID"

# Shell environment
github_username: "your-github-username"
goprivate: "github.com/your-org"

# Optional: private dotfiles repo (e.g. work-only functions/config)
# If set, Ansible will clone it to ~/.dotfiles-secret and symlink any
# files under `zsh/functions/` into `~/.zsh/functions.secret/`.
dotfiles_secret_repo: ""
# dotfiles_secret_dir: "/absolute/path/to/.dotfiles-secret"

