GOBIN=$HOME/go/bin
USERBIN=$HOME/.local/bin
export PATH="$PATH:$GOBIN:$USERBIN"

export GITHUB_USERNAME={{ github_username | default(ansible_facts.env.GITHUB_USERNAME | default('')) }}
export KUBE_EDITOR="code --wait"
export GOPRIVATE={{ goprivate | default(ansible_facts.env.GOPRIVATE | default('')) }}

# GPG configuration for commit signing
export GPG_TTY=$(tty)

