get-kube-secret-and-decode() {
  local ns name

  case $# in
    1) ns="default"; name="$1" ;;
    2) ns="$1";      name="$2" ;;
    *)
      print "Usage: get-kube-secret-and-decode [namespace] <secret-name>" >&2
      print "Alias: ksec [namespace] <secret-name>" >&2
      return 2
      ;;
  esac

  if ! command -v kubectl >/dev/null 2>&1; then
    print "Error: kubectl is not installed" >&2
    return 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    print "Warning: jq not found, falling back to basic go-template" >&2
    kubectl get secret -n "$ns" "$name" -o go-template='
{{- range $k, $v := .data}}{{printf "%s: %s\n" $k ($v | base64decode)}}{{end -}}
{{- range $k, $v := .stringData}}{{printf "%s: %s\n" $k $v}}{{end -}}'
    return $?
  fi

  kubectl get secret -n "$ns" "$name" -o json | jq -r '
    ((.data // {} | map_values(@base64d)) + (.stringData // {}))
    | to_entries
    | sort_by(.key)
    | .[]
    | "\(.key): \(.value)"
  '
}

alias ksec='get-kube-secret-and-decode'

