# Zsh configuration file =================================================

# Docker CLI completions need to be in fpath before compinit
fpath=(/Users/{{ username }}/.docker/completions $fpath)

# Initialize zsh's completion system
autoload -Uz compinit
compinit

# Use emacs-style keybindings (Meta-f / Meta-b, etc.)
bindkey -e

# Natural word movement in the shell
WORDCHARS=''

# Secrets and environment variables ======================================

# Environment variables
source ~/.zsh/env

# Secrets
if [ -f ~/.zsh/secrets ]; then
  source ~/.zsh/secrets
fi

# Aliases and functions ==================================================

# File system
if command -v eza &> /dev/null; then
  alias l='eza -lh --group-directories-first --icons=auto'
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

# Directories / zoxide wrapper
if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if [ $# -eq 0 ]; then
      builtin cd ~ && return
    elif [ -d "$1" ]; then
      builtin cd "$1"
    else
      z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
    fi
  }
fi

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias d='docker'
alias k='kubectl'
alias g='git'
n() { if [ "$#" -eq 0 ]; then nvim .; else nvim "$@"; fi; }

# Kubectl completion
if command -v kubectl >/dev/null 2>&1; then
  # Ship kubectl's completion definitions into zsh
  source <(kubectl completion zsh)

  # Make alias `k` use kubectl completion instead of file completion
  compdef __start_kubectl k
fi

# Plugins and enhancements ===============================================

# Autosuggestions
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# zoxide
eval "$(zoxide init zsh)"

# starship
eval "$(starship init zsh)"

# atuin shell integration
. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

# syntax highlighting
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# mise
eval "$(/Users/{{ username }}/.local/bin/mise activate zsh)"